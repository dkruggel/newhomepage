@page "/events-editor"
@using System.Text.Json
@using newhomepage.Shared.Models
@inject IJSRuntime JSRuntime

<div class="app-container">
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid navbar-content">
            <a class="navbar-brand" href="#">Events</a>
            <div class="clock d-flex">Events Editor</div>
        </div>
    </nav>

    <main class="main-content">
        <div class="card">
            <div class="card-header">
                <h2>Manage Personal Events</h2>
                <a class="btn btn-link" href="/">Back</a>
            </div>
            <div class="card-body">
                <div>
                    <label>Event name</label>
                    <input @bind="newEventName" class="form-control" />
                </div>
                <div class="mt-2">
                    <label>Date (MM-DD or YYYY-MM-DD)</label>
                    <input @bind="newEventDate" class="form-control" placeholder="MM-DD or YYYY-MM-DD" />
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary" @onclick="AddEvent">Add</button>
                    <button class="btn btn-secondary ms-2" @onclick="SaveEvents">Save</button>
                    <button class="btn btn-link ms-2" @onclick="ResetEvents">Reset to repo defaults</button>
                </div>

                <hr />

                <div>
                    <h3>Saved events</h3>
                    @if (personalEvents != null && personalEvents.Any())
                    {
                        <ul class="list-group">
                            @foreach (var e in personalEvents.Select((val, idx) => new { val, idx }))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <div><strong>@e.val.Event</strong></div>
                                        <div class="text-muted">@e.val.Date</div>
                                    </div>
                                    <div>
                                        <button class="btn btn-sm btn-danger"
                                            @onclick="(() => RemoveEvent(e.idx))">Remove</button>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="loading">No saved events yet.</div>
                    }
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    private List<PersonalEvent> personalEvents = new();
    private string newEventName = string.Empty;
    private string newEventDate = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadSavedEvents();
    }

    private async Task LoadSavedEvents()
    {
        try
        {
            var stored = await JSRuntime.InvokeAsync<string>("appLocalStorage.getItem", "personal-events");
            if (!string.IsNullOrEmpty(stored))
            {
                try
                {
                    personalEvents = JsonSerializer.Deserialize<List<PersonalEvent>>(stored) ?? new List<PersonalEvent>();
                }
                catch
                {
                    personalEvents = new List<PersonalEvent>();
                }
            }
        }
        catch
        {
            personalEvents = new List<PersonalEvent>();
        }
    }

    private async Task SaveEvents()
    {
        try
        {
            var json = JsonSerializer.Serialize(personalEvents);
            await JSRuntime.InvokeVoidAsync("appLocalStorage.setItem", "personal-events", json);
        }
        catch { }
    }

    private void AddEvent()
    {
        if (string.IsNullOrWhiteSpace(newEventName) || string.IsNullOrWhiteSpace(newEventDate)) return;

        personalEvents.Add(new PersonalEvent { Event = newEventName.Trim(), Date = newEventDate.Trim() });
        newEventName = string.Empty;
        newEventDate = string.Empty;
    }

    private void RemoveEvent(int idx)
    {
        if (idx >= 0 && idx < personalEvents.Count)
        {
            personalEvents.RemoveAt(idx);
        }
    }

    private async Task ResetEvents()
    {
        await JSRuntime.InvokeVoidAsync("appLocalStorage.removeItem", "personal-events");
        personalEvents.Clear();
    }
}