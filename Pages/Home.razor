@page "/"
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.Components.Web
@using newhomepage.Shared.Models
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject newhomepage.Shared.Services.EventParser EventParser

<div class="app-container">
    <!-- Header with Hamburger Menu and Clock -->
    @* <header class="navbar">
        <div class="navbar-content">
            <div class="navbar-left">
                <button class="hamburger-btn" @onclick="ToggleMenu">
                    <span class="hamburger-line"></span>
                    <span class="hamburger-line"></span>
                    <span class="hamburger-line"></span>
                </button>
                <h1 class="navbar-title">My Dashboard</h1>
            </div>
            <div class="navbar-right">
                <div class="clock">@currentTime.ToString("HH:mm:ss")</div>
            </div>
        </div>
    </header> *@
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid navbar-content">
            <a class="navbar-brand" href="#">David Kruggel</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                aria-label="Toggle navigation" tabindex="0" @onkeydown="@(e => OnTogglerKeyDown(e))">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="#">Home</a>
                    </li>
                </ul>
                <div class="clock d-flex">@currentTime.ToString("hh:mm:ss tt")</div>
            </div>
        </div>
    </nav>

    <!-- Side Menu Overlay -->
    <div class="menu-overlay @(isMenuOpen ? "show" : "")" @onclick="CloseMenu"></div>

    <!-- Side Menu -->
    <nav class="side-menu @(isMenuOpen ? "open" : "")" role="navigation" aria-label="Main menu"
        aria-hidden="@(isMenuOpen ? "false" : "true")">
        <div class="menu-header">
            <h3>Menu</h3>
            <button class="close-btn" @onclick="CloseMenu" tabindex="0"
                @onkeydown="@(e => OnCloseKeyDown(e))">&times;</button>
        </div>
        <ul class="menu-items">
            <li><a href="/">Home</a></li>
            <li><a href="/weather">Weather</a></li>
            <li><a href="/calendar">Calendar</a></li>
            <li><a href="/settings">Settings</a></li>
        </ul>
    </nav>

    <!-- Main Content -->
    <main id="main-content" class="main-content" tabindex="-1">
        <!-- Weather Card -->
        <div class="card weather-card">
            <div class="card-header">
                <h2>Weather</h2>
                <span class="location" @onclick="ChangeLocation">@weatherData?.Location.Name,
                    @weatherData?.Location.Region</span>
            </div>
            <div class="card-body">
                @if (isLoadingWeather)
                {
                    <!-- Skeleton placeholders while weather loads -->
                    <div class="current-weather">
                        <div class="skeleton skeleton-title" style="width:120px;height:56px;"></div>
                        <div style="flex:1">
                            <div class="skeleton skeleton-text" style="width:40%"></div>
                            <div class="skeleton skeleton-text" style="width:30%"></div>
                        </div>
                        <div class="skeleton skeleton-rect" style="width:64px;height:64px;" />
                    </div>
                    <div class="forecast" aria-hidden="true">
                        @for (int i = 0; i < 3; i++)
                        {
                            <div class="forecast-item">
                                <div class="skeleton skeleton-text" style="width:60%"></div>
                                <div class="skeleton skeleton-text" style="width:80%"></div>
                            </div>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(weatherLoadError))
                {
                    <div role="alert" class="card-body">
                        <div class="loading">Error loading weather: @weatherLoadError</div>
                        <button class="btn btn-primary" @onclick="LoadWeatherData">Retry</button>
                        <button class="btn btn-secondary ms-2" @onclick="ClearWeatherCache">Clear Cache</button>
                    </div>
                }
                else if (weatherData != null)
                {
                    <div class="current-weather">
                        <div class="current-temp">@weatherData.Current.Temp_F°F</div>
                        <div class="current-desc">@weatherData.Current.Condition.Description</div>
                        <img src="@weatherData.Current.Condition.Icon" />
                        <div class="today-temp">
                            @weatherData.Forecast.ForecastDays[0].Day.High°/@weatherData.Forecast.ForecastDays[0].Day.Low°
                        </div>
                    </div>
                    <div class="forecast">
                        @foreach (var day in weatherData.Forecast.ForecastDays.Skip(1))
                        {
                            <div class="forecast-item">
                                <div class="day">
                                    @{
                                        var date = DateTime.Parse(day.Date);
                                    }
                                    @date.ToString("ddd")</div>
                                <div class="day">
                                    @date.ToString("yyyy.MM.dd")
                                </div>
                                <div class="temp">@day.Day.High°/@day.Day.Low°</div>
                                <div class="desc">@day.Day.Condition.Description</div>
                                <img src="@day.Day.Condition.Icon" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="loading">Weather is unavailable.</div>
                }
            </div>
        </div>

        <!-- Countdown Card -->
        <div class="card countdown-card">
            <div class="card-header">
                <h2>Important Dates</h2>
                <a class="btn btn-link" href="/events-editor">Manage Events</a>
            </div>
            <div class="card-body">
                @if (isLoadingEvents)
                {
                    <div>
                        <div class="skeleton skeleton-title" style="width:40%"></div>
                        <div class="skeleton skeleton-text" style="width:100%"></div>
                        <div class="skeleton skeleton-text" style="width:90%"></div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(eventsLoadError))
                {
                    <div role="alert" class="loading">Error loading events: @eventsLoadError</div>
                }
                else if (countdownEvents != null && countdownEvents.Any())
                {
                    @foreach (var eventItem in countdownEvents)
                    {
                        var daysUntil = (eventItem.Date - DateTime.Today).Days;
                        <div class="countdown-item @(daysUntil <= urgentThresholdDays ? "urgent" : "") @(eventItem.IsHoliday ? "holiday" : "")">
                            <div class="event-info">
                                <div class="event-name">@eventItem.Event</div>
                                <div class="event-date">@eventItem.Date.ToString("MMMM dd, yyyy")</div>
                            </div>
                            <div class="countdown-days">
                                @if (daysUntil > 0)
                                {
                                    <span class="days-number">@daysUntil</span>
                                    <span class="days-label">day@(daysUntil == 1 ? "" : "s")</span>
                                }
                                else if (daysUntil == 0)
                                {
                                    <span class="days-today">Today!</span>
                                }
                                else
                                {
                                    <span class="days-past">@Math.Abs(daysUntil) day@(Math.Abs(daysUntil) == 1 ? "" : "s")
                                        ago</span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="loading">No upcoming events. Add some in Manage Events.</div>
                }
            </div>
        </div>
    </main>
</div>

@code {
    private bool isMenuOpen = false;
    private DateTime currentTime = DateTime.Now;
    private Timer? timer;
    private WeatherData? weatherData;
    private List<CountdownEvent>? countdownEvents;
    private bool isLoadingLocation = false;
    private string currentLocation = "";
    // Quick-win UI state
    private bool isLoadingWeather = true;
    private bool isLoadingEvents = true;
    private string? weatherLoadError = null;
    private string? eventsLoadError = null;

    // App settings (from localStorage)
    private AppSettings appSettings = new();
    private int urgentThresholdDays = 7;
    private string nextYearIncludeAfter = "11-01"; // MM-DD

    protected override async Task OnInitializedAsync()
    {
        // Start the clock timer
        timer = new Timer(UpdateTime, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));

        // Load app settings, then start data loads
        await LoadAppSettings();

        // Start loads in parallel but keep UI responsive
        _ = LoadWeatherData();
        _ = LoadCountdownEvents();
    }

    private async Task LoadAppSettings()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("appLocalStorage.getItem", "app-settings");
            if (!string.IsNullOrEmpty(json))
            {
                try
                {
                    appSettings = JsonSerializer.Deserialize<AppSettings>(json) ?? new AppSettings();
                }
                catch { appSettings = new AppSettings(); }
            }
        }
        catch { appSettings = new AppSettings(); }

        urgentThresholdDays = appSettings.EventUrgentThresholdDays ?? 7;
        nextYearIncludeAfter = string.IsNullOrEmpty(appSettings.NextYearHolidaysIncludeAfter) ? "11-01" :
        appSettings.NextYearHolidaysIncludeAfter;

        if (!string.IsNullOrEmpty(appSettings.DefaultLocation) && string.IsNullOrEmpty(currentLocation))
        {
            currentLocation = appSettings.DefaultLocation;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
window.getUserLocation = () => {
return new Promise((resolve, reject) => {
if (!navigator.geolocation) {
reject('Geolocation is not supported');
return;
}

navigator.geolocation.getCurrentPosition(
position => resolve({
latitude: position.coords.latitude,
longitude: position.coords.longitude
}),
error => reject(error.message),
{ enableHighAccuracy: true, timeout: 10000, maximumAge: 300000 }
);
});
};

window.promptForLocation = (currentLocation) => {
const newLocation = prompt('Enter your location (city, state or city, country):', currentLocation || '');
return newLocation;
};
");

            // Register a .NET-side handler to receive app-settings change notifications from JS
            try
            {
                // Wire the SettingsBridge event so Home can react when settings change via dispatchAppSettings
                newhomepage.Shared.Services.SettingsBridge.SettingsChanged += async (json) =>
                {
                    try
                    {
                        // Reload settings and refresh dependent data
                        await LoadAppSettings();
                        _ = LoadWeatherData();
                        _ = LoadCountdownEvents();
                        await InvokeAsync(StateHasChanged);
                    }
                    catch { }
                };
            }
            catch { }
        }
        else
        {
            if (string.IsNullOrEmpty(currentLocation) && !isLoadingLocation)
            {
                await GetUserLocation();
            }
        }
    }

    private void UpdateTime(object? state)
    {
        currentTime = DateTime.Now;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    private void CloseMenu()
    {
        isMenuOpen = false;
    }

    private async Task GetUserLocation()
    {
        try
        {
            isLoadingLocation = true;
            StateHasChanged();

            try
            {
                // Try to get GPS coordinates
                var location = await JSRuntime.InvokeAsync<LocationCoords>("getUserLocation");

                // Reverse geocode to get city name
                var geoResult = await
                Http.GetStringAsync($"https://api.bigdatacloud.net/data/reverse-geocode-client?latitude={location.Latitude}&longitude={location.Longitude}&localityLanguage=en");
                var geoData = JsonSerializer.Deserialize<GeocodeResult>(geoResult, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

                if (geoData != null && !string.IsNullOrEmpty(geoData.City))
                {
                    currentLocation = $"{geoData.City}, {geoData.CountryCode}";
                }
                else
                {
                    currentLocation = $"{location.Latitude:F2}, {location.Longitude:F2}";
                }
            }
            catch
            {
                // If GPS fails, try IP-based location
                try
                {
                    var ipResult = await Http.GetStringAsync("https://ipapi.co/json/");
                    var ipData = JsonSerializer.Deserialize<IPLocationResult>(ipResult, new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });

                    if (ipData != null && !string.IsNullOrEmpty(ipData.City))
                    {
                        currentLocation = $"{ipData.Postal}";
                    }
                    else
                    {
                        currentLocation = "Location unavailable";
                    }
                }
                catch
                {
                    currentLocation = "63366"; // Final fallback
                }
            }

            await LoadWeatherData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting location: {ex.Message}");
            currentLocation = "63366"; // Fallback
            await LoadWeatherData();
        }
        finally
        {
            isLoadingLocation = false;
            StateHasChanged();
        }
    }

    private async Task ChangeLocation()
    {
        try
        {
            var newLocation = await JSRuntime.InvokeAsync<string>("promptForLocation", currentLocation);

            if (!string.IsNullOrWhiteSpace(newLocation) && newLocation != currentLocation)
            {
                isLoadingLocation = true;
                currentLocation = newLocation;
                StateHasChanged();

                await LoadWeatherData();

                isLoadingLocation = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error changing location: {ex.Message}");
            isLoadingLocation = false;
            StateHasChanged();
        }
    }

    private async Task LoadWeatherData()
    {
        isLoadingWeather = true;
        weatherLoadError = null;
        StateHasChanged();

        try
        {
            // Read API key from configuration (wwwroot/appsettings.json or other configuration provider).
            var apiKey = Configuration["Weather:ApiKey"] ?? Configuration["WeatherApiKey"];

            var cacheKey = $"weather-cache:{(string.IsNullOrEmpty(currentLocation) ? "default" : currentLocation)}";

            // Try cache first (15 minute TTL)
            try
            {
                var cached = await JSRuntime.InvokeAsync<string>("appLocalStorage.getItem", cacheKey);
                if (!string.IsNullOrEmpty(cached))
                {
                    try
                    {
                        using var doc = JsonDocument.Parse(cached);
                        if (doc.RootElement.TryGetProperty("timestamp", out var tsElem) && doc.RootElement.TryGetProperty("response", out var
                        respElem))
                        {
                            var ts = tsElem.GetDateTime();
                            if ((DateTime.UtcNow - ts).TotalMinutes <= 15)
                            {
                                var resp = respElem.GetString();
                                if (!string.IsNullOrEmpty(resp))
                                {
                                    weatherData = JsonSerializer.Deserialize<WeatherData>(resp);
                                    isLoadingWeather = false;
                                    StateHasChanged();
                                    return;
                                }
                            }
                        }
                    }
                    catch { /* cache parse errors - ignore and continue */ }
                }
            }
            catch { /* localStorage may be unavailable */ }

            string forecastResponse;
            if (string.IsNullOrWhiteSpace(apiKey))
            {
                // No client-side API key: try calling a server-side proxy if available at /api/weather
                try
                {
                    forecastResponse = await Http.GetStringAsync($"/api/weather?location={Uri.EscapeDataString(currentLocation)}");
                }
                catch (Exception ex)
                {
                    weatherLoadError = "No API key configured and server proxy unavailable";
                    Console.WriteLine($"Weather proxy error: {ex.Message}");
                    return;
                }
            }
            else
            {
                forecastResponse = await
                Http.GetStringAsync($"https://api.weatherapi.com/v1/forecast.json?key={apiKey}&q={currentLocation}&days=6&aqi=no&alerts=no");
            }
            weatherData = JsonSerializer.Deserialize<WeatherData>(forecastResponse);

            // Cache response
            try
            {
                var cacheObj = new { timestamp = DateTime.UtcNow, response = forecastResponse };
                var cacheJson = JsonSerializer.Serialize(cacheObj);
                await JSRuntime.InvokeVoidAsync("appLocalStorage.setItem", cacheKey, cacheJson);
            }
            catch { /* ignore cache failures */ }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Handle error - you might want to log this
            Console.WriteLine($"Error loading weather data: {ex.Message}");
            weatherLoadError = ex.Message;
        }
        finally
        {
            isLoadingWeather = false;
            StateHasChanged();
            // Announce status to screen readers
            try
            {
                var announce = string.IsNullOrEmpty(weatherLoadError) ? "Weather updated" : $"Weather failed to load: {weatherLoadError}";
                await JSRuntime.InvokeVoidAsync("setAriaLive", announce);
            }
            catch { }
        }
    }

    private async Task LoadCountdownEvents()
    {
        isLoadingEvents = true;
        eventsLoadError = null;
        StateHasChanged();

        try
        {
            var allEvents = new List<CountdownEvent>();

            // First check localStorage for user-managed events
            try
            {
                var stored = await JSRuntime.InvokeAsync<string>("appLocalStorage.getItem", "personal-events");
                if (!string.IsNullOrEmpty(stored))
                {
                    try
                    {
                        var parsed = EventParser.ParsePersonalEvents(stored, DateTime.Today);
                        if (parsed != null && parsed.Count > 0)
                        {
                            allEvents.AddRange(parsed);
                        }
                    }
                    catch { /* parsing failures -> fall back to file */ }
                }
            }
            catch { /* localStorage not available -> continue */ }

            // If no local events, fallback to repo file
            if (!allEvents.Any())
            {
                try
                {
                    var json = await Http.GetStringAsync("data/events.json");
                    var parsed = EventParser.ParsePersonalEvents(json, DateTime.Today);
                    if (parsed != null && parsed.Count > 0)
                    {
                        allEvents.AddRange(parsed);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading personal events: {ex.Message}");
                }
            }

            // Load holidays from API (best-effort). Fetch current year and next year so near-year-end
            // holidays (e.g. New Year's Day) are included.
            try
            {
                var currentYear = DateTime.Now.Year;
                // Always fetch the current year. Optionally fetch next year after the configured threshold (MM-DD)
                var yearsToFetch = new List<int> { currentYear };
                try
                {
                    var parts = nextYearIncludeAfter.Split('-', StringSplitOptions.RemoveEmptyEntries);
                    if (parts.Length == 2 && int.TryParse(parts[0], out var mon) && int.TryParse(parts[1], out var day))
                    {
                        var threshold = new DateTime(currentYear, Math.Clamp(mon, 1, 12), Math.Clamp(day, 1, DateTime.DaysInMonth(currentYear, Math.Clamp(mon,1,12))));
                        if (DateTime.Now > threshold)
                        {
                            yearsToFetch.Add(currentYear + 1);
                        }
                    }
                }
                catch { /* invalid config -> skip next-year fetch */ }

                var fetched = new List<HolidayData>();

                foreach (var y in yearsToFetch)
                {
                    try
                    {
                        var holidayJson = await Http.GetStringAsync($"https://date.nager.at/api/v3/publicholidays/{y}/US");
                        var holidays = JsonSerializer.Deserialize<List<HolidayData>>(holidayJson, new JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        });

                        if (holidays != null)
                        {
                            fetched.AddRange(holidays);
                        }
                    }
                    catch (Exception innerEx)
                    {
                        // ignore per-year failures but continue
                        Console.WriteLine($"Warning: failed to fetch holidays for {y}: {innerEx.Message}");
                    }
                }

                if (fetched.Any())
                {
                    // Deduplicate by date+name and include only upcoming dates
                    var holidayEvents = fetched
                    .GroupBy(h => (h.Date.Date, h.Event))
                    .Select(g => g.First())
                    .Where(h => h.Date.Date >= DateTime.Today)
                    .Select(h => new CountdownEvent
                    {
                        Event = $"🎉 {h.Event}",
                        Date = h.Date.Date,
                        IsHoliday = true
                    })
                    .OrderBy(h => h.Date)
                    .ToList();

                    allEvents.AddRange(holidayEvents);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading holidays: {ex.Message}");
            }

            // Sort by date and limit
            countdownEvents = allEvents
            .OrderBy(e => e.Date)
            .Take(10)
            .ToList();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in LoadCountdownEvents: {ex.Message}");
            eventsLoadError = ex.Message;
            countdownEvents = new List<CountdownEvent> { new CountdownEvent { Event = "Sample Event", Date =
DateTime.Today.AddDays(30), IsHoliday = false } };
            StateHasChanged();
        }
        finally
        {
            isLoadingEvents = false;
            StateHasChanged();
            try
            {
                var announce = string.IsNullOrEmpty(eventsLoadError) ? "Events updated" : $"Events failed to load: {eventsLoadError}";
                await JSRuntime.InvokeVoidAsync("setAriaLive", announce);
            }
            catch { }
        }
    }

    public void Dispose()
    {
        timer?.Dispose();
    }

    private void OnTogglerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " " || e.Code == "Space")
        {
            ToggleMenu();
        }
    }

    private void OnCloseKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " " || e.Code == "Space")
        {
            CloseMenu();
        }
    }

    private async Task ClearWeatherCache()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("clearWeatherCache");
        }
        catch { }

        // Force reload of weather
        weatherData = null;
        weatherLoadError = null;
        isLoadingWeather = true;
        StateHasChanged();
        await LoadWeatherData();
    }
}